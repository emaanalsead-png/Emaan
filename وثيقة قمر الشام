| 3 | user_private_blocks.write | الأطراف فقط |
| 4 | user_notifications.read | owner only |
| 5 | user_presence.write | owner only |
| 6 | audit_log.read | 90+ |
| 6أ | reports.read | 90+ |
| 6ب | guardian_calls.read | 90+ |
| 6ج | room_kicks.write | 65+ |
| 6د | users/$uid/lastSeen.write | owner only |
| 6هـ | queenOrder.write | King only |

### 5.2 المسارات الجديدة المطلوبة

**من device-guard.js:**
```json
"device_registry": {
  "$deviceId": {
    ".read": "auth != null",
    "$uid": { ".write": "auth.uid === $uid" }
  }
},
"ip_registry": {
  "$ipHash": {
    ".read": "auth != null",
    "$uid": { ".write": "auth.uid === $uid" }
  }
},
"banned_devices": {
  ".read": true,
  "$deviceId": { ".write": "root.child('users').child(auth.uid).child('rankLevel').val() >= 90" }
},
"banned_ips": {
  ".read": true,
  "$ipHash": { ".write": "root.child('users').child(auth.uid).child('rankLevel').val() >= 90" }
},
"multi_account_alerts": {
  ".read": "root.child('users').child(auth.uid).child('rankLevel').val() >= 100",
  ".write": "auth != null",
  ".indexOn": ["time"]
},
"users": {
  "$uid": {
    "devices":   { ".write": "auth.uid === $uid" },
    "ipHashes":  { ".write": "auth.uid === $uid" }
  }
}
